# ==============================================================================
# Shelfspace Backend Environment Configuration (Vercel + Neon)
# ==============================================================================

# Server & Runtime
PORT=5000
NODE_ENV=development

# Database (Neon PostgreSQL connection string)
# - For Vercel Serverless Production: Use Neon Pooled connection string (-pooler in host)
#   Format: postgresql://[user]:[password]@[endpoint]-pooler.[region].neon.tech/[dbname]?sslmode=require
# - For local migration/seeding: Direct or pooled connection string
DATABASE_URL=postgresql://user:password@endpoint-pooler.neon.tech/neondb?sslmode=require

# Serverless Connection Pool Limits (Default 5 in production, 20 in dev)
PG_MAX_POOL=5

# Authentication & JWT Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET=shelfspace_dev_access_secret_super_secure_key_12345
JWT_REFRESH_SECRET=shelfspace_dev_refresh_secret_super_secure_key_67890
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# CORS Allowed Origins (Comma-separated for multiple origins, no trailing slashes)
# Local: http://localhost:5173
# Vercel Production: https://shelfspace.vercel.app (and preview URLs)
FRONTEND_URL=http://localhost:5173

# Cookie Settings for Cross-Subdomain Vercel Deployments:
# - When frontend is shelfspace.vercel.app and backend is shelfspace-api.vercel.app,
#   browsers treat them as cross-site. COOKIE_SAME_SITE must be 'none' and COOKIE_SECURE must be 'true'.
# - COOKIE_DOMAIN: Leave empty for host-only cookies (standard for *.vercel.app).
#   If using a custom apex domain (e.g. app.shelfspace.dev & api.shelfspace.dev), set .shelfspace.dev
COOKIE_DOMAIN=
COOKIE_SAME_SITE=none
COOKIE_SECURE=true

# Scheduled Maintenance / Vercel Cron Secret
# Protects GET /api/cron/cleanup-trash from unauthorized external invocations.
# Vercel automatically passes this as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=generate_a_random_32_char_secret_for_cron_here

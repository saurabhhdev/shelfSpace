# ==============================================================================
# Shelfspace Backend Environment Configuration
# ==============================================================================

# Server
PORT=5000
NODE_ENV=development

# Database (Neon PostgreSQL connection string)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# Authentication & JWT Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET=shelfspace_dev_access_secret_super_secure_key_12345
JWT_REFRESH_SECRET=shelfspace_dev_refresh_secret_super_secure_key_67890
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# CORS Allowed Origins (Comma-separated for multiple origins, no trailing slashes)
# Local: http://localhost:5173
# Production: https://shelfspace.vercel.app or https://yourdomain.com
FRONTEND_URL=http://localhost:5173

# Cookie Settings
# COOKIE_DOMAIN: Optional. Leave empty for host-only cookies, or set e.g. .yourdomain.com for shared subdomains
# COOKIE_SAME_SITE: lax | strict | none (Use 'none' with HTTPS if frontend and backend are on different domains)
# COOKIE_SECURE: true | false (Auto-detected as true in production; required if COOKIE_SAME_SITE=none)
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

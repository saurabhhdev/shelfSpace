# ==============================================================================
# Shelfspace Workspace — Environment Configuration Reference
# ==============================================================================
# Copy the relevant variables to backend/.env and frontend/.env respectively.
# Never commit real credentials or .env files to source control.

# ------------------------------------------------------------------------------
# 1. Backend Environment Variables (backend/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require
JWT_ACCESS_SECRET=shelfspace_dev_access_secret_super_secure_key_12345
JWT_REFRESH_SECRET=shelfspace_dev_refresh_secret_super_secure_key_67890
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
FRONTEND_URL=http://localhost:5173
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 2. Frontend Environment Variables (frontend/.env)
# ------------------------------------------------------------------------------
# Local: /api (proxied by Vite to http://localhost:5000)
# Production: https://<your-backend-api-url>/api
VITE_API_URL=/api

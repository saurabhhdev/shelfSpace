# ==============================================================================
# Shelfspace Workspace — Environment Configuration Reference (Vercel + Neon)
# ==============================================================================
# Copy the relevant variables to backend/.env and frontend/.env respectively.
# For Vercel, enter these into the respective Vercel Project Environment Variables.
# Never commit real credentials or .env files to source control.

# ------------------------------------------------------------------------------
# 1. Backend Project Environment Variables (Project: shelfspace-api)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
# Use the Neon pooled connection string (-pooler in host) for serverless production
DATABASE_URL=postgresql://user:password@endpoint-pooler.neon.tech/neondb?sslmode=require
PG_MAX_POOL=5
JWT_ACCESS_SECRET=generate_strong_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=generate_strong_random_secret_at_least_32_characters
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
FRONTEND_URL=https://shelfspace.vercel.app
COOKIE_DOMAIN=
COOKIE_SAME_SITE=none
COOKIE_SECURE=true
CRON_SECRET=generate_strong_random_secret_for_cron_maintenance

# ------------------------------------------------------------------------------
# 2. Frontend Project Environment Variables (Project: shelfspace)
# ------------------------------------------------------------------------------
# Local: /api (proxied by Vite to http://localhost:5000)
# Vercel Production: https://shelfspace-api.vercel.app/api
VITE_API_URL=https://shelfspace-api.vercel.app/api
